# Copy to .env and fill in. Never commit .env.

# --- Required --------------------------------------------------------------------------------
# Long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Database passwords (used by docker compose to build the connection strings)
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app

# --- Application -----------------------------------------------------------------------------
APP_ENV=development
# Demo endpoints that sign identity tokens for the fictional customers. Set false in production.
DEMO_MODE=true
LOG_JSON=true
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- LLM providers (any OpenAI-compatible API) ------------------------------------------------
# Without any provider the agent runs in degraded mode: rule-based planner and answers built from
# tool data and quoted documents. Paid example: OpenAI (see README for costs).
LLM_PRIMARY_BASE_URL=https://api.openai.com/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_FAST_MODEL=gpt-4.1-nano
LLM_PRIMARY_SMART_MODEL=gpt-4.1-mini
# Optional second provider, tried when the first fails (e.g. Groq, OpenRouter, or the local llama.cpp server).
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_FAST_MODEL=
LLM_FALLBACK_SMART_MODEL=
# Free local option: docker compose --profile local-llm up -d, then
#   LLM_PRIMARY_BASE_URL=http://llm:8080/v1  LLM_PRIMARY_FAST_MODEL=qwen3-1.7b  LLM_PRIMARY_SMART_MODEL=qwen3-1.7b
#   LLM_DISABLE_THINKING=true
LLM_DISABLE_THINKING=false
LLM_TIMEOUT_SECONDS=120
# auto | always_fast | always_smart
ROUTER_MODE=auto

# --- Retrieval -------------------------------------------------------------------------------
# local = multilingual ONNX model, no key; openai = text-embedding-3-small at 384 dimensions
EMBEDDING_PROVIDER=local
# cross_encoder (multilingual mMiniLM, local) or none
RERANKER_PROVIDER=cross_encoder

# --- Voice -----------------------------------------------------------------------------------
# local_whisper (free, CPU) | openai | disabled
STT_PROVIDER=local_whisper
# browser (free, the visitor's device voices) | openai
TTS_PROVIDER=browser
# Only for STT_PROVIDER/TTS_PROVIDER=openai (falls back to LLM_PRIMARY_API_KEY)
VOICE_API_KEY=

# --- Observability (Langfuse Cloud or self-hosted, see docker-compose.langfuse.yml) -------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse-web:3000

# --- Seed --------------------------------------------------------------------------------------
# Password of the fictional demo staff accounts (default: demo-password-2026)
SEED_STAFF_PASSWORD=
