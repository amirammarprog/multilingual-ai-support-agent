# Copy to .env and fill in. Never commit .env.

# --- Required --------------------------------------------------------------------------------
# Long random string, e.g.: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=

# Database passwords (used by docker compose to build the connection strings)
POSTGRES_PASSWORD=change-me-owner
APP_DB_PASSWORD=change-me-app

# --- Application -----------------------------------------------------------------------------
APP_ENV=development
# Demo endpoints that sign identity tokens for the fictional customers. Set false in production.
DEMO_MODE=true
LOG_JSON=true
CORS_ORIGINS=http://localhost:8080,http://localhost:5173

# --- LLM providers (any OpenAI-compatible API) ------------------------------------------------
# Without any provider the agent runs in degraded mode: rule-based planner and answers built from
# tool data and quoted documents. Paid example: OpenAI (see README for costs).
LLM_PRIMARY_BASE_URL=https://api.openai.com/v1
LLM_PRIMARY_API_KEY=
LLM_PRIMARY_FAST_MODEL=gpt-4.1-nano
LLM_PRIMARY_SMART_MODEL=gpt-4.1-mini
# Optional second provider, tried when the first fails (e.g. Groq, OpenRouter, or the local llama.cpp server).
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_FAST_MODEL=
LLM_FALLBACK_SMART_MODEL=
# Free local option: docker compose --profile local-llm up -d, then
#   LLM_PRIMARY_BASE_URL=http://llm:8080/v1  LLM_PRIMARY_FAST_MODEL=qwen3-1.7b  LLM_PRIMARY_SMART_MODEL=qwen3-1.7b
#   LLM_DISABLE_THINKING=true
LLM_DISABLE_THINKING=false
LLM_TIMEOUT_SECONDS=120
# auto | always_fast | always_smart
ROUTER_MODE=auto

# --- Free-tier API keys (you create the account; the key stays in this file, never in git) ----
# Model ids change often. After setting a key, list what it can use and test it with:
#   docker compose --profile dev run --rm dev python -m app.cli llm-check
#
# Groq: https://console.groq.com/keys (free plan, limits per model, shown in the console)
#   LLM_PRIMARY_BASE_URL=https://api.groq.com/openai/v1
#   LLM_PRIMARY_FAST_MODEL=openai/gpt-oss-20b        (example id; pick from llm-check)
#   LLM_PRIMARY_SMART_MODEL=openai/gpt-oss-120b      (example id; pick from llm-check)
#   LLM_REASONING_EFFORT=low
#   LLM_EXTRA_OUTPUT_TOKENS=1024
#   LLM_PRIMARY_REQUESTS_PER_MINUTE=20
#
# Google Gemini: https://aistudio.google.com/apikey (free tier; prompts may be used by Google,
# which is fine for the fictional demo data but not for real customer data)
#   LLM_PRIMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
#   LLM_PRIMARY_FAST_MODEL=<a "flash-lite" model id from llm-check>
#   LLM_PRIMARY_SMART_MODEL=<a "flash" model id from llm-check>
#   LLM_PRIMARY_REQUESTS_PER_MINUTE=8
#
# OpenRouter: https://openrouter.ai/keys (free models end with ":free"; about 20 requests/min and
# 50 requests/day until $10 of credits are bought, so a full evaluation takes several days)
#   LLM_PRIMARY_BASE_URL=https://openrouter.ai/api/v1
#   LLM_PRIMARY_FAST_MODEL=<model id>:free
#   LLM_PRIMARY_SMART_MODEL=<model id>:free
#   LLM_PRIMARY_REQUESTS_PER_MINUTE=15

# Pacing and retries (0 = no client-side pacing). Waits longer than LLM_MAX_RETRY_WAIT_SECONDS
# (a daily quota) fail fast; an evaluation run can then be resumed later with --resume latest.
LLM_PRIMARY_REQUESTS_PER_MINUTE=0
LLM_FALLBACK_REQUESTS_PER_MINUTE=0
LLM_MAX_RETRIES=4
LLM_MAX_RETRY_WAIT_SECONDS=90
# auto (JSON schema, JSON mode for models that reject it) | json_schema | json_object
LLM_RESPONSE_FORMAT=auto
# Sent as reasoning_effort to reasoning models when set (e.g. low)
LLM_REASONING_EFFORT=
# Reasoning models (gpt-oss, qwen3...) spend output tokens on hidden reasoning before the JSON
# answer: this many tokens are added to every call's output limit (e.g. 1024).
LLM_EXTRA_OUTPUT_TOKENS=0

# --- Evaluation judge (optional; default = the primary provider's smart model) -------------
# A small free model can be a weak judge: the report shows how often it agrees with the
# deterministic checks and warns below 70%.
JUDGE_MODEL=
JUDGE_BASE_URL=
JUDGE_API_KEY=
JUDGE_REQUESTS_PER_MINUTE=0

# --- Retrieval -------------------------------------------------------------------------------
# local = multilingual ONNX model, no key; openai = text-embedding-3-small at 384 dimensions
EMBEDDING_PROVIDER=local
# cross_encoder (multilingual mMiniLM, local) or none
RERANKER_PROVIDER=cross_encoder

# --- Voice -----------------------------------------------------------------------------------
# local_whisper (free, CPU) | openai | disabled
STT_PROVIDER=local_whisper
# browser (free, the visitor's device voices) | openai
TTS_PROVIDER=browser
# Only for STT_PROVIDER/TTS_PROVIDER=openai (falls back to LLM_PRIMARY_API_KEY)
VOICE_API_KEY=

# --- Observability (Langfuse Cloud or self-hosted, see docker-compose.langfuse.yml) -------------
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=http://langfuse-web:3000

# --- Seed --------------------------------------------------------------------------------------
# Password of the fictional demo staff accounts (default: demo-password-2026)
SEED_STAFF_PASSWORD=
